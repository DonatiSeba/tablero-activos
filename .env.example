# Copy this file to .env for local Docker Compose configuration.
# These values are development-only examples. Do not use production credentials here.
POSTGRES_DB=asset_reconciliation
POSTGRES_USER=asset_app
POSTGRES_PASSWORD=local-development-only-change-me
APP_PORT=8080
# APP_ENV=development permits the session cookie over local HTTP only.
# Set APP_ENV to production (or any non-development value) for Secure cookies.
APP_ENV=development
# Generate a unique value for every deployment: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-this-development-session-secret-with-a-unique-48-character-value
SESSION_TTL_SECONDS=28800
